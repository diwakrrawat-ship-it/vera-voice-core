{
  "expo": {
    "name": "VERA: Voice Core",
    "slug": "vera-voice-core-new",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.diwakarsinghrawat.veravoicecore",
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "plugins": [
      "expo-font"
    ],
    "owner": "diwakar1s-team",
    "extra": {
      "eas": {
        "projectId": "21e1d331-347f-40e3-8e87-114e50a40e1a"
      }
    }
  }
}
